{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://uywajtcwayeueimxcvzv.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "polished-learner-app",
      "version": "0.1.0",
      "title": "Polished Learner App"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in TSJ Scholar member's profile: name, role, class and exam track.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_announcements",
        "title": "List announcements",
        "description": "List the most recent school announcements visible to the signed-in member.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many announcements to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_calendar_events",
        "title": "List calendar events",
        "description": "List upcoming school calendar events (classes, tests, holidays) from today onwards.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many events to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "from_date": {
              "description": "ISO date (YYYY-MM-DD) to start from. Defaults to today.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_live_classes",
        "title": "List live classes",
        "description": "List scheduled, live and recorded online classes visible to the signed-in member.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many classes to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "description": "Filter by class status.",
              "type": "string",
              "enum": [
                "scheduled",
                "live",
                "ended"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_test_results",
        "title": "List test results",
        "description": "List test attempts and scores the signed-in member is allowed to see (own results for students).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many attempts to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_doubts",
        "title": "List doubts",
        "description": "List doubt-room questions visible to the signed-in member, optionally only unanswered ones.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many doubts to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "only_unanswered": {
              "description": "When true, return only doubts that have no answer yet.",
              "type": "boolean"
            },
            "subject": {
              "description": "Filter by subject name.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "ask_doubt",
        "title": "Ask a doubt",
        "description": "Post a new text doubt to the TSJ Scholar doubt room as the signed-in student.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "description": "Subject of the doubt, e.g. Physics."
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "description": "The doubt/question text."
            },
            "visibility": {
              "description": "Who can see the doubt (default public).",
              "type": "string",
              "enum": [
                "public",
                "private"
              ]
            }
          },
          "required": [
            "subject",
            "question"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
